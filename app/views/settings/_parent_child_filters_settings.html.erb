<%
  # A lambda rather than a method: `def` inside a template defines the method on
  # the view class for the whole process.
  check_box = lambda do |setting_key|
    content_tag :p do
      # The checkbox carries the same label as the filter it enables, so the
      # settings page and the filter dropdown cannot disagree. enable_<x>_filter
      # maps to label_filter_<x>.
      filter = setting_key.delete_prefix('enable_').delete_suffix('_filter')
      # check_box_tag derives its id from the name, so the label must point at
      # "settings_<key>" for clicking it to toggle the box.
      #
      # The hidden 0 is what Redmine's own setting_check_box does: a browser sends
      # nothing at all for an unticked box, so without it "off" would be stored as
      # the absence of a key rather than as a value, and the two would have to be
      # told apart everywhere. With it the stored value is always 0 or 1.
      label_tag("settings_#{setting_key}", l("label_filter_#{filter}")) +
        hidden_field_tag("settings[#{setting_key}]", 0, :id => nil) +
        check_box_tag("settings[#{setting_key}]", 1, RedmineParentChildFilters.enabled?(@settings[setting_key]))
    end
  end
%>
<fieldset class="box tabular settings">
  <legend><%= l(:label_general_filters_settings) %></legend>
  <%= check_box.call('enable_root_id_filter') %>
  <%= check_box.call('enable_root_tracker_id_filter') %>
  <%= check_box.call('enable_root_status_id_filter') %>
  <%= check_box.call('enable_parent_tracker_id_filter') %>
  <%= check_box.call('enable_parent_status_id_filter') %>
  <%= check_box.call('enable_a_parent_tracker_id_filter') %>
  <%= check_box.call('enable_a_parent_status_id_filter') %>
  <%= check_box.call('enable_child_tracker_id_filter') %>
  <%= check_box.call('enable_child_status_id_filter') %>
  <%= check_box.call('enable_a_child_tracker_id_filter') %>
  <%= check_box.call('enable_a_child_status_id_filter') %>
</fieldset>

<fieldset class="box tabular settings">
  <legend><%= l(:label_tree_filters_settings) %></legend>
  <%= check_box.call('enable_tree_has_parent_or_child_filter') %>
  <%= check_box.call('enable_tree_tracker_id_filter') %>
  <%= check_box.call('enable_tree_status_id_filter') %>
  <%= check_box.call('enable_tree_parent_tracker_id_filter') %>
  <%= check_box.call('enable_tree_parent_status_id_filter') %>
  <%= check_box.call('enable_tree_child_tracker_id_filter') %>
  <%= check_box.call('enable_tree_child_status_id_filter') %>
</fieldset>

<fieldset class="box tabular settings">
  <legend><%= l(:label_involvement_filters_settings) %></legend>
  <%= check_box.call('enable_involved_id_filter') %>
  <%= check_box.call('enable_mentioned_id_filter') %>
  <%= check_box.call('enable_involved_or_mentioned_id_filter') %>
  <p class="info"><%= l(:text_mention_filters_cost) %></p>
</fieldset>

<fieldset class="box tabular settings">
  <legend><%= l(:label_specific_filters_settings) %></legend>
  <%= check_box.call('enable_a_specific_parent_tracker_id_filter') %>
  <%= check_box.call('enable_a_specific_parent_status_id_filter') %>
  <%
    # The same range the query enforces, so the form cannot offer a level the
    # filters would then refuse.
    depths = (1..RedmineParentChildFilters::MAX_DEPTH).to_a
    # What the filters will actually use, after the stored values have been
    # normalised. It differs from the two selects when the pair is reversed or
    # was written by something other than this form, and saying so beats leaving
    # the administrator to guess.
    effective = RedmineParentChildFilters.depth_range
  %>
  <p>
    <%= label_tag 'settings_min_depth', l('label_min_depth') %>
    <%= select_tag 'settings[min_depth]', options_for_select(depths, @settings['min_depth'].to_i) %>
  </p>
  <p>
    <%= label_tag 'settings_max_depth', l('label_max_depth') %>
    <%= select_tag 'settings[max_depth]', options_for_select(depths, @settings['max_depth'].to_i) %>
    <%#
      What a level means, and what the filters will actually use after the stored
      values have been normalised. Both are composed from numbers and Redmine's own
      field_parent_issue, so they read grammatically in every language the plugin
      ships without needing a sentence translated into fifty of them.
    %>
    <em class="info">
      <%= "1 = #{l(:field_parent_issue)}" %> &middot; <%= "#{effective.first}–#{effective.last}" %>
    </em>
  </p>
</fieldset>
